{
  "name": "blocky-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run packages",
    "test:contracts": "vitest run tests/contracts",
    "check": "pnpm typecheck && pnpm test:unit && pnpm test:contracts",
    "check:core": "pnpm check && pnpm test:component && pnpm test:host && pnpm build:cli && pnpm test:cli && pnpm test:e2e:build && pnpm test:e2e && pwsh -NoProfile -File scripts/check-native-core.ps1 core",
    "check:full": "pnpm check:core && pwsh -NoProfile -File scripts/check-native-core.ps1 full",
    "blocky": "node tools/blocky-cli/dist/main.mjs",
    "build:cli": "pnpm build:builder && cargo build --manifest-path apps/studio-host/Cargo.toml --release --bin blocky-project-io && pnpm --dir tools/blocky-cli build",
    "build:builder": "node scripts/build-builder.mjs",
    "test:component": "vitest run tests/component",
    "test:host": "cargo test --manifest-path apps/studio-host/Cargo.toml --lib --bin blocky-project-io",
    "test:cli": "vitest run tests/cli",
    "test:e2e:build": "pwsh -NoProfile -File scripts/build-native-tests.ps1",
    "test:e2e": "wdio run tests/e2e/wdio.conf.ts",
    "dev": "pnpm build:builder && pnpm --dir apps/studio-host tauri dev",
    "build": "pnpm build:builder && pnpm --dir apps/studio-host tauri build --no-bundle && node scripts/install-builder.mjs apps/studio-host/target/release",
    "build:release": "pwsh -NoProfile -File scripts/build-release.ps1",
    "check:release": "node scripts/check-release.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@wdio/types": "9.30.1",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
