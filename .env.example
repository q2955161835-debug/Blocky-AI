# Optional Host-only path to verified local Embedding assets.
# Leave unset in the distribution to use the bundled models directory.
# Development example (set in the launching shell; .env is not auto-loaded):
BLOCKY_MODEL_DIR=try/stage3/models/multilingual-e5-small
# Prepare the five hash-locked files with: node scripts/prepare-knowledge-model.mjs
# The Host accepts no model download URL or model path from the WebView.
# Releases share models/multilingual-e5-small between Studio and cli/bin.

# Optional real Provider key. Import through Studio or CLI into Host secure storage.
# Never enter a key into a project, prompt, command-line argument or resource JSON.
DEEPSEEK_API_KEY=replace-with-your-own-key
# The current Provider uses DeepSeek's fixed official endpoint and non-thinking text mode.
# Set the model ID in a user-scoped ModelProfile; .env is not automatically loaded.
