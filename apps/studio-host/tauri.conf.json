{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blocky Studio",
  "version": "0.8.0",
  "identifier": "ai.blocky.studio",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../studio-desktop build",
    "beforeDevCommand": "pnpm --dir ../studio-desktop dev",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../studio-desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Blocky Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-U50efV7Bkv9x8dIhIzpF+EQcHTo7ixuQounKy51hR+Y=' 'sha256-rlptcWizcz4xgVOYQjzXggGSjOtLi20/Gpv5SPZ4xz4='; connect-src ipc: http://ipc.localhost; frame-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
