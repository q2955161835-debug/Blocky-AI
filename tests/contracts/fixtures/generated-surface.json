{
  "project": {
    "manifest": {
      "schemaVersion": "blocky.project/v1",
      "projectId": "research-workbench",
      "displayName": "资料问答伙伴",
      "modules": [
        {
          "moduleId": "research-agent",
          "displayName": "研究助手",
          "purpose": "agent",
          "workspaceRef": "workspaces/research-agent.workspace.json",
          "exports": [
            {
              "exportId": "answer-with-citations",
              "displayName": "生成带引用回答",
              "kind": "agent",
              "inputSchemaRef": "schemas/question.json",
              "outputSchemaRef": "schemas/answer.json"
            }
          ]
        },
        {
          "moduleId": "citation-service",
          "displayName": "引用服务",
          "purpose": "service",
          "workspaceRef": "workspaces/citation-service.workspace.json",
          "exports": [
            {
              "exportId": "lookup-v1",
              "displayName": "检索引用",
              "kind": "tool",
              "inputSchemaRef": "schemas/query.json",
              "outputSchemaRef": "schemas/citations.json"
            }
          ]
        }
      ],
      "resources": [
        {
          "resourceId": "product-handbook",
          "kind": "knowledge",
          "scope": "project",
          "definitionRef": "resources/product-handbook.json",
          "secretRefs": [
            "handbook-access"
          ]
        },
        {
          "resourceId": "local-composer",
          "kind": "model",
          "scope": "project",
          "definitionRef": "resources/local-composer.json",
          "secretRefs": []
        }
      ],
      "appSurfaces": [],
      "format": {
        "createdWith": "blocky-desktop/0.2.0",
        "minimumReaderVersion": "0.2.0"
      }
    },
    "workspaces": {
      "research-agent": {
        "blocks": {
          "languageVersion": 0,
          "blocks": [
            {
              "type": "core.agent",
              "id": "research-root",
              "x": 80,
              "y": 70,
              "fields": {
                "ROLE": "用清晰可靠的中文回答，只引用资料中的事实"
              },
              "inputs": {
                "BODY": {
                  "block": {
                    "type": "core.interaction.chat",
                    "id": "on-question",
                    "fields": {
                      "NAME": "资料问答"
                    },
                    "next": {
                      "block": {
                        "type": "core.module.call",
                        "id": "call-citation",
                        "fields": {
                          "MODULE": "citation-service",
                          "EXPORT": "lookup-v1",
                          "INPUT": "schemas/query.json",
                          "OUTPUT": "schemas/citations.json"
                        },
                        "next": {
                          "block": {
                            "type": "core.model.compose",
                            "id": "compose-answer",
                            "fields": {
                              "RESOURCE": "local-composer"
                            },
                            "next": {
                              "block": {
                                "type": "core.output.answer",
                                "id": "reply-answer",
                                "fields": {
                                  "STYLE": "条目"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "citation-service": {
        "blocks": {
          "languageVersion": 0,
          "blocks": [
            {
              "type": "core.tool.entry",
              "id": "lookup-entry",
              "x": 80,
              "y": 70,
              "fields": {
                "EXPORT": "lookup-v1"
              },
              "inputs": {
                "BODY": {
                  "block": {
                    "type": "core.knowledge.retrieve",
                    "id": "lookup-documents",
                    "fields": {
                      "RESOURCE": "product-handbook"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "resources": {
      "product-handbook": {
        "schemaVersion": "blocky.resource/v1alpha1",
        "resourceId": "product-handbook",
        "kind": "knowledge",
        "scope": "project",
        "displayName": "自然科学资料",
        "definition": {
          "collection": "science",
          "implementationRef": "adapter://deterministic/knowledge-v1"
        },
        "capabilityRequirements": [
          "knowledge.read"
        ],
        "secretBindings": [
          {
            "fieldId": "access",
            "secretRef": "handbook-access"
          }
        ]
      },
      "local-composer": {
        "schemaVersion": "blocky.resource/v1alpha1",
        "resourceId": "local-composer",
        "kind": "model",
        "scope": "project",
        "displayName": "本地文本整理",
        "definition": {
          "implementationRef": "adapter://deterministic/composer-v1"
        },
        "capabilityRequirements": [],
        "secretBindings": []
      }
    },
    "schemas": {
      "schemas/question.json": {
        "type": "string"
      },
      "schemas/query.json": {
        "type": "string"
      },
      "schemas/answer.json": {
        "type": "object"
      },
      "schemas/cited-answer.json": {
        "type": "object"
      },
      "schemas/citations.json": {
        "type": "array"
      }
    },
    "surfaces": {}
  },
  "draft": {
    "manifest": {
      "schemaVersion": "blocky.app-surface/v1",
      "surfaceId": "surface-generated-contract",
      "displayName": "设备报修",
      "sourceRootRef": "surfaces/surface-generated-contract/src",
      "associatedModuleIds": [
        "research-agent"
      ],
      "bridgeRef": "surfaces/surface-generated-contract/bridge.json",
      "permissions": [
        "surface.preview",
        "surface.invoke.ask"
      ],
      "build": {
        "packageManager": "pnpm",
        "lockfileRef": "surfaces/surface-generated-contract/pnpm-lock.yaml",
        "outputRef": "surfaces/surface-generated-contract/dist"
      }
    },
    "files": {
      "surfaces/surface-generated-contract/src/page.html": "<!doctype html>\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Blocky</title><link rel=\"stylesheet\" href=\"page.css\"></head><body><template id=\"surface-spec\">{\"attachment\":true,\"confirmation\":true,\"description\":\"填写故障信息\",\"fields\":[{\"id\":\"device\",\"label\":\"设备名称\",\"options\":[],\"required\":true,\"type\":\"text\"},{\"id\":\"severity\",\"label\":\"紧急程度\",\"options\":[\"一般\",\"紧急\"],\"required\":true,\"type\":\"select\"}],\"layout\":\"split\",\"resultLabel\":\"处理建议\",\"schemaVersion\":\"blocky.surface-spec/v1\",\"submitLabel\":\"生成建议\",\"title\":\"设备报修\"}</template><header><p>BLOCKY</p><h1 id=\"title\"></h1><p id=\"description\"></p></header><main id=\"layout\"><form id=\"task-form\"><div id=\"actions\"><label id=\"attachment-label\" hidden>文本附件<input id=\"attachment\" type=\"file\" accept=\".txt,.md,.csv\"></label><div class=\"buttons\"><button id=\"submit\" type=\"button\" disabled>连接中…</button><button id=\"stop\" type=\"button\" disabled>停止</button></div></div></form><section aria-live=\"polite\"><h2 id=\"result-title\"></h2><p id=\"status\"></p><details><summary>运行进度</summary><ol id=\"progress\"></ol></details><div id=\"answer\"></div><ul id=\"citations\"></ul></section></main><script src=\"page.js\"></script></body></html>\n",
      "surfaces/surface-generated-contract/src/page.css": ":root{font:16px system-ui,sans-serif;color:#20352c;background:#f3f6f1;color-scheme:light}*{box-sizing:border-box}body{margin:0;padding:32px 24px}header,main{max-width:1100px;margin:auto}header>p:first-child{font-size:12px;letter-spacing:.18em;color:#4b7b61}h1{font-size:32px}h2{font-size:20px}main{display:grid;gap:24px;margin-top:32px}.split{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}form,section{background:#fff;padding:24px;border:1px solid #d6e0d7;border-radius:14px}form{display:flex;flex-direction:column;gap:12px}input,textarea,select{font:inherit;padding:12px;border:1px solid #afc1b4;border-radius:6px;min-width:0}textarea{min-height:140px;resize:vertical}label{font-weight:600}.buttons{display:flex;gap:10px;margin-top:18px}button{font:inherit;background:#286d4b;color:white;padding:12px 18px;border:0;border-radius:7px;cursor:pointer}button:disabled{opacity:.5}#stop{background:#596b60}#attachment-label input{display:block;width:100%;margin-top:8px}#answer{white-space:pre-wrap;line-height:1.7;overflow-wrap:anywhere}#status{color:#596b60}li{padding:6px} [hidden]{display:none!important}@media(max-width:700px){body{padding:20px 12px}.split{grid-template-columns:1fr}form,section{padding:18px}h1{font-size:26px}}\n",
      "surfaces/surface-generated-contract/src/page.js": "(() => {\n  const spec = JSON.parse(document.getElementById('surface-spec').content.textContent);\n  document.title = spec.title;\n  const byId = id => document.getElementById(id);\n  byId('title').textContent = spec.title;\n  byId('description').textContent = spec.description;\n  byId('result-title').textContent = spec.resultLabel;\n  byId('layout').className = spec.layout;\n  const controls = new Map(), form = byId('task-form'), submit = byId('submit'), stop = byId('stop'), status = byId('status');\n  for (const field of spec.fields) {\n    const label = document.createElement('label'), control = document.createElement(field.type === 'text' ? 'input' : field.type);\n    label.textContent = field.label; control.id = `field-${field.id}`; label.htmlFor = control.id; control.required = field.required;\n    if (field.type === 'select') for (const option of field.options) { const el = document.createElement('option'); el.value = el.textContent = option; control.append(el); }\n    else control.maxLength = 2000;\n    form.insertBefore(label, byId('actions')); form.insertBefore(control, byId('actions')); controls.set(field.id, control);\n  }\n  byId('attachment-label').hidden = !spec.attachment;\n  let port, pending, sequence = 0;\n  window.addEventListener('message', event => {\n    if (event.source !== parent || event.data?.kind !== 'blocky.bridge.init' || port || event.ports.length !== 1) return;\n    port = event.ports[0]; submit.disabled = false; submit.textContent = spec.submitLabel;\n    port.onmessage = ({data: reply}) => {\n      if (!reply || reply.requestId !== pending) return;\n      if (reply.kind === 'progress') {status.textContent = reply.message;const line=document.createElement('li');line.textContent=reply.message;byId('progress').append(line);while(byId('progress').children.length>50)byId('progress').firstElementChild.remove();return;}\n      pending = undefined;submit.disabled = false;stop.disabled = true;\n      status.textContent = reply.ok ? '已完成' : '已停止或未能完成，请查看工作台运行状态。';\n      byId('answer').textContent = reply.ok ? reply.answer : '';\n      byId('citations').replaceChildren();\n      for (const citation of reply.ok && Array.isArray(reply.citations) ? reply.citations : []) {const item=document.createElement('li');item.textContent=`${citation.title} · ${citation.locator}`;byId('citations').append(item);}\n    };port.start();\n  });\n  submit.addEventListener('click', async () => {\n    if (!port || pending || !form.reportValidity()) return;\n    pending = `request-${++sequence}`;submit.disabled=true;stop.disabled=false;status.textContent='准备提交…';byId('progress').replaceChildren();byId('answer').textContent='';byId('citations').replaceChildren();\n    const requestId=pending;\n    try {\n      const file=byId('attachment').files[0];let attachment;\n      if (spec.attachment && file) {\n        if (file.size>16000 || !/\\.(txt|md|csv)$/i.test(file.name)) throw Error();\n        attachment={name:file.name,text:await file.text()};\n      }\n      if(pending!==requestId)return;\n      port.postMessage({schemaVersion:'blocky.bridge-request/v1',requestId,endpointId:'ask',values:Object.fromEntries([...controls].map(([id,control])=>[id,control.value])),...(attachment?{attachment}:{})});\n      status.textContent='运行中…';\n    }catch{if(pending===requestId){pending=undefined;submit.disabled=false;stop.disabled=true;status.textContent='附件需为不超过 16 KB 的文本、Markdown 或 CSV 文件。';}}\n  });\n  stop.addEventListener('click',()=>{if(!pending)return;port?.postMessage({schemaVersion:'blocky.bridge-cancel/v1',requestId:pending});pending=undefined;submit.disabled=false;stop.disabled=true;status.textContent='已请求停止';});\n})();\n",
      "surfaces/surface-generated-contract/package.json": {
        "name": "blocky-generated-surface",
        "version": "1.0.0",
        "private": true,
        "type": "module",
        "dependencies": {}
      },
      "surfaces/surface-generated-contract/pnpm-lock.yaml": "lockfileVersion: '9.0'\nsettings:\n  autoInstallPeers: true\n  excludeLinksFromLockfile: false\nimporters:\n  .: {}\n",
      "surfaces/surface-generated-contract/surface-spec.json": {
        "schemaVersion": "blocky.surface-spec/v1",
        "title": "设备报修",
        "description": "填写故障信息",
        "layout": "split",
        "submitLabel": "生成建议",
        "resultLabel": "处理建议",
        "attachment": true,
        "confirmation": true,
        "fields": [
          {
            "id": "device",
            "label": "设备名称",
            "type": "text",
            "required": true,
            "options": []
          },
          {
            "id": "severity",
            "label": "紧急程度",
            "type": "select",
            "required": true,
            "options": [
              "一般",
              "紧急"
            ]
          }
        ]
      },
      "surfaces/surface-generated-contract/manifest.json": {
        "schemaVersion": "blocky.app-surface/v1",
        "surfaceId": "surface-generated-contract",
        "displayName": "设备报修",
        "sourceRootRef": "surfaces/surface-generated-contract/src",
        "associatedModuleIds": [
          "research-agent"
        ],
        "bridgeRef": "surfaces/surface-generated-contract/bridge.json",
        "permissions": [
          "surface.preview",
          "surface.invoke.ask"
        ],
        "build": {
          "packageManager": "pnpm",
          "lockfileRef": "surfaces/surface-generated-contract/pnpm-lock.yaml",
          "outputRef": "surfaces/surface-generated-contract/dist"
        }
      },
      "surfaces/surface-generated-contract/bridge.json": {
        "schemaVersion": "blocky.frontend-bridge/v1alpha1",
        "surfaceId": "surface-generated-contract",
        "endpoints": [
          {
            "endpointId": "ask",
            "direction": "invoke",
            "target": {
              "moduleId": "research-agent",
              "exportId": "answer-with-citations"
            },
            "inputSchemaRef": "schemas/question.json",
            "outputSchemaRef": "schemas/answer.json",
            "approval": "never"
          }
        ]
      }
    }
  }
}
