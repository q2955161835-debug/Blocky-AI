{
  "name": "blocky-windows-core-spike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:wdio": "tsc -b && vite build --mode wdio",
    "tauri": "tauri",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e:build": "tauri build --no-bundle --features wdio --config src-tauri/tauri.wdio.conf.json",
    "test:e2e": "node ./scripts/prepare-wdio-artifacts.mjs && wdio run ./wdio.conf.ts --spec ./tests/e2e/windows-core.e2e.ts && node ./scripts/audit-wdio-logs.mjs",
    "test:performance": "node ./scripts/prepare-wdio-artifacts.mjs && wdio run ./wdio.conf.ts --spec ./tests/e2e/windows-core-performance.e2e.ts && node ./scripts/audit-wdio-logs.mjs",
    "test:e2e:logs": "node ./scripts/audit-wdio-logs.mjs",
    "test:soak": "node ./scripts/prepare-wdio-artifacts.mjs && wdio run ./wdio.conf.ts --spec ./tests/e2e/windows-core-soak.e2e.ts && node ./scripts/audit-wdio-logs.mjs",
    "check": "pwsh -NoProfile -File ./scripts/verify-spike.ps1 -Fast",
    "check:core": "pwsh -NoProfile -File ./scripts/verify-spike.ps1",
    "check:full": "pwsh -NoProfile -File ./scripts/verify-spike.ps1 -IncludeSoak"
  },
  "dependencies": {
    "@fluentui/react-icons": "2.0.316",
    "@tauri-apps/api": "2.11.1",
    "blockly": "13.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@wdio/types": "9.30.1",
    "jsdom": "30.0.1",
    "jszip": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
