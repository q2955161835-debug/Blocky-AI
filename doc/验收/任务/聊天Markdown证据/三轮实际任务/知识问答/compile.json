{"schemaVersion":"blocky.cli/v1","ok":true,"command":"project.compile","data":{"modules":[{"schemaVersion":"blocky.module-ir/v1","projectId":"project-84bc347d-d3cc-429c-a67e-bd7613dea7ea","moduleId":"main","roots":[{"nodeId":"assistant-root","blockType":"core.agent","fields":{"ROLE":"你是刑事法条学习问答助手，专门基于 assistant-knowledge 资料（仅覆盖《刑法》第133条与第133条之一）回答法律学习问题。回答必须引用资料原文并准确区分两个罪名：第133条是交通肇事罪，第133条之一是危险驾驶罪。只做条文学习与对比说明，不推断、不评判任何具体案件。"},"inputs":{"BODY":{"nodeId":"assistant-chat-trigger","blockType":"core.interaction.chat","fields":{"NAME":"资料问答"},"inputs":{},"next":{"nodeId":"assistant-evidence-instructions","blockType":"core.prompt.context","fields":{"TEXT":"回答前必须先检索 assistant-knowledge 资料并通过证据护栏，只依据命中的条文原文作答。引用时可核对的原文并明确标注来自第133条还是第133条之一，清楚区分交通肇事罪与危险驾驶罪的构成差异。资料未命中或覆盖范围外时如实说明边界，不编造、不推断具体案件。"},"inputs":{},"next":{"nodeId":"assistant-run-budget","blockType":"core.run.budget","fields":{"CALLS":"256","OUTPUT_TOKENS":"1048576","STEPS":"10000","TIMEOUT_MS":"1800000"},"inputs":{},"next":{"nodeId":"assistant-knowledge-retrieve","blockType":"core.knowledge.retrieve","fields":{"RESOURCE":"assistant-knowledge"},"inputs":{},"next":{"nodeId":"assistant-evidence-guardrail","blockType":"core.guardrail.evidence","fields":{"POLICY":"require"},"inputs":{},"next":{"nodeId":"assistant-compose-answer","blockType":"core.model.compose","fields":{"RESOURCE":"markdown-e2e-model"},"inputs":{},"next":{"nodeId":"assistant-answer","blockType":"core.output.answer","fields":{"STYLE":"段落"},"inputs":{}}}}}}}}}}],"exports":[],"sourceMap":{"assistant-root":{"projectId":"project-84bc347d-d3cc-429c-a67e-bd7613dea7ea","moduleId":"main","blockId":"assistant-root"},"assistant-chat-trigger":{"projectId":"project-84bc347d-d3cc-429c-a67e-bd7613dea7ea","moduleId":"main","blockId":"assistant-chat-trigger"},"assistant-evidence-instructions":{"projectId":"project-84bc347d-d3cc-429c-a67e-bd7613dea7ea","moduleId":"main","blockId":"assistant-evidence-instructions"},"assistant-run-budget":{"projectId":"project-84bc347d-d3c