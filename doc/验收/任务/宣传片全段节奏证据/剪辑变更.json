      "assetId": "1e199023-a9e5-4914-bd74-45038b9bcabf",
      "code": "const Component=({item})=>{const f=useCurrentFrame(),p=item.props||{};const a=Math.min(1,Math.max(0,(f-9)/6));return <div style={{height:\"100%\",width:\"100%\",boxSizing:\"border-box\",padding:\"15px 28px\",background:p.paper,border:\"2px solid #E5FA7866\",borderRadius:18,fontFamily:p.font,opacity:a}}><div style={{fontSize:28,fontWeight:800,color:p.accent,marginBottom:7}}>{p.title}</div><div style={{fontSize:26,fontWeight:600,color:p.ink,lineHeight:1.25}}>{p.line1}<br/>{p.line2}</div><div style={{display:\"flex\",justifyContent:\"space-between\",fontSize:22,marginTop:8,color:\"#C6D3D6\"}}><span style={{opacity:Math.min(1,Math.max(0,(f-65)/7))}}>{p.result}</span><span>{p.foot}</span></div></div>;};",
      "frames": 150
    },
    "logo": {
      "assetId": "90dcc083-5205-4adf-b186-1c9f94ca2e1d",
      "code": "const Component = ({ item }) => {\n  const frame = useCurrentFrame();\n  const p = item.props;\n  const rootStyle = {position:'absolute',inset:0,backgroundColor:'transparent',display:'flex',alignItems:'center',padding:12};\n  const fontSize = Math.min(164,1120/Math.max(7,p.text.length));\n  const rowStyle = {display:'flex',alignItems:'baseline',color:p.ink,fontFamily:p.font,fontSize:fontSize,fontWeight:900,lineHeight:1.15,letterSpacing:-4,whiteSpace:'nowrap'};\n  const chars = p.text.split('');\n  const letters = chars.map((char,index)=>{\n    const start = 38 + index*4;\n    const alpha = interpolate(frame,[start,start+8],[0,1],{extrapolateLeft:'clamp',extrapolateRight:'clamp'});\n    const lift = interpolate(frame,[start,start+5,start+10],[20,-4,0],{extrapolateLeft:'clamp',extrapolateRight:'clamp'});\n    const style = {display:'inline-block',opacity:alpha,transform:'translateY('+lift+'px)'};\n    return <span key={index} style={style}>{char}</span>;\n  });\n  return <div style={rootStyle}><div style={rowStyle}>{letters}</div></div>;\n};",
      "frames": 180
    }
  },
