[
  {
    "schemaVersion": "blocky.resource-definition/v1",
    "kind": "model",
    "title": "模型",
    "definitionSchema": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "format": "id"
        },
        "connectionRef": {
          "type": "string",
          "format": "id"
        },
        "connectionRevision": {
          "type": "number",
          "minimum": 1,
          "maximum": 2147483647,
          "integer": true
        },
        "baseUrl": {
          "type": "string",
          "format": "public-https"
        },
        "modelId": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "openai-chat",
            "openai-responses",
            "native",
            "local"
          ]
        },
        "timeoutMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600000,
          "integer": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "tools",
              "structured-output",
              "embedding",
              "rerank"
            ]
          }
        },
        "parameters": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "integer": false
            },
            "topP": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "integer": false
            },
            "maxOutputTokens": {
              "type": "number",
              "minimum": 1,
              "maximum": 10000000,
              "integer": true
            },
            "retries": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "integer": true
            },
            "concurrency": {
              "type": "number",
              "minimum": 1,
              "maximum": 128,
              "integer": true
            },
            "contextLength": {
              "type": "number",
              "minimum": 1,
              "maximum": 10000000,
              "integer": true
            }
          },
          "required": []
        },
        "implementationRef": {
          "type": "object",
          "format": "implementation-ref",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "adapter",
                "package",
                "task"
              ]
            },
            "id": {
              "type": "string",
              "format": "id"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        "localRuntime": {
          "type": "object",
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "cpu",
                "vulkan"
              ]
            },
            "device": {
              "type": "string",
              "format": "id"
            },
            "contextTokens": {
              "type": "number",
              "minimum": 1024,
              "maximum": 8192,
              "integer": true
            },
            "threads": {
              "type": "number",
              "minimum": 1,
              "maximum": 16,
              "integer": true
            },
            "memoryMb": {
              "type": "number",
              "minimum": 2048,
              "maximum": 32768,
              "integer": true
            }
          },
          "required": [
            "backend"
          ]
        }
      },
      "required": [
        "provider",
        "modelId",
        "protocol",
        "timeoutMs",
        "capabilities"
      ]
    },
    "secretFields": [
      "apiKey",
      "baseUrl",
      "authorization",
      "headers",
      "proxy"
    ]
  },
