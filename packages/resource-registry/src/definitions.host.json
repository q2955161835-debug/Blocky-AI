            "rerankResourceId": {
              "type": "string",
              "format": "id"
            },
            "rerankModelId": {
              "type": "string",
              "enum": [
                "ms-marco-minilm-l6-v2-int8-v1"
              ]
            },
            "maxCandidates": {
              "type": "number",
              "minimum": 1,
              "maximum": 200,
              "integer": true
            },
            "minScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "integer": false
            },
            "contextBudget": {
              "type": "number",
              "minimum": 64,
              "maximum": 64000,
              "integer": true
            },
            "rerank": {
              "type": "boolean"
            },
            "timeoutMs": {
              "type": "number",
              "minimum": 50,
              "maximum": 120000,
              "integer": true
            },
            "fallback": {
              "type": "string",
              "enum": [
                "error",
                "keyword"
              ]
            },
            "modelId": {
              "type": "string",
              "format": "id"
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "value"
                ]
              }
            }
          },
          "required": [
            "strategy",
            "topK"
          ]
        }
      },
      "required": [
        "chunking",
        "retrieval"
      ]
    },
    "secretFields": [
      "access"
